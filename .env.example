# Copy this file to .env and fill in real values for local development.
# On Replit, set these as Secrets instead of committing a .env file.

# --- Server ---
PORT=8000
CORS_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=30

# --- Database (PostgreSQL — e.g. Supabase or Neon free tier) ---
# Leave empty to run in DEMO MODE (in-memory, non-persistent — fine for trying things out).
DATABASE_URL=

# --- Device auth ---
# Any long random string. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
DEVICE_SIGNING_SECRET=
# PROTOTYPING ONLY: set to true to skip device token auth entirely (all
# clients share one conversation history). Never use in production.
DISABLE_DEVICE_AUTH=false

# --- Online AI: fallback chain, tried in this order: OpenRouter -> Z.ai -> NVIDIA ---
# Leave a key empty to skip that provider entirely. At least one must be filled
# for online chat mode to work. LLM_PROVIDER is just a label for logs/reference.
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.2:free

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.5-flash

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Local AI (Ollama, for offline mode) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Limits ---
RATE_LIMIT=20/minute
MAX_PROMPT_CHARS=4000
MAX_HISTORY_MESSAGES=20
MAX_REQUEST_BYTES=200000
